num = df_raw.select_dtypes("number")
med = num.median().replace(0, np.nan)

summary = pd.DataFrame({
    "nunique":  num.nunique(),
    "null_pct": num.isna().mean().round(3),
    "min":      num.min(),
    "median":      num.median(),
    "max":      num.max(),
    "max_over_median": (num.max() / med).round(1),
}).sort_values("max_over_median", ascending=False)

