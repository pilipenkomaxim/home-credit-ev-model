from sklearn.model_selection import RandomizedSearchCV

param_dist = {
    'max_depth':[3, 4, 5, 6],
    'learning_rate':[0.02, 0.03, 0.05, 0.08],
    'n_estimators':[300, 500, 700],
    'subsample':[0.7, 0.85, 1.0],
    'colsample_bytree':[0.5, 0.7, 0.9],
    'min_child_weight':[1, 5, 10, 20],
    'reg_lambda':[1, 5, 10, 20],
}

xgb_full = XGBClassifier(eval_metric='aucpr', n_jobs=-1, random_state=42)

search = RandomizedSearchCV(
    xgb_full, param_distributions=param_dist, n_iter=20,
    scoring='average_precision', cv=cv, random_state=42, verbose=1,
)

search.fit(X_train_xgb, y_train)

pred_xgb_full = cross_val_predict(xgb_full, X_train_xgb, y_train, cv=cv)

print(round(search.best_score_, 4), search.best_params_)
